# 应用配置示例：复制为 app/.env 后按本地情况修改。
# 不要提交真实 token。所有值都是占位或本机默认值。

# PowerContext Server
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=replace-with-token-from-powercontext-env

# 留空则由应用首次启动时创建 scope 并写入 app.db
POWERCONTEXT_SCOPE_ID=

# 创建 scope 时用的标题（仅首次生效）
RECALLCOACH_SCOPE_TITLE=RecallCoach · 数据库系统
# 同一个 idempotency_key 重复建 scope 会得到同一个 scope
RECALLCOACH_SCOPE_KEY=recallcoach-db

# 应用
APP_PORT=8080

# 运行时数据（相对 app/ 目录；已加入 .gitignore）
RECALLCOACH_DB=.runtime/app.db
RECALLCOACH_AUDIT=.runtime/memory_audit.jsonl

# 固定“今天”，让验证样例可复现；留空使用系统日期
RECALLCOACH_TODAY=

# on = 读写记忆；off = 纯到期排序且不写记忆
RECALLCOACH_PERSONALIZATION=on
