# PowerContext 配置示例
# 真实文件由 scripts/bootstrap.ps1 生成在 %USERPROFILE%\.recallcoach\powercontext.env
# 该文件含 token，必须限制 ACL，且不要提交到任何仓库或贴进截图。

# 开启 Bearer 鉴权（本项目需要它来启用 Dashboard 证据页）
POWERCONTEXT_SERVER_ACCESS_MODE=enforced
POWERCONTEXT_SERVER_AUTH_TOKEN=replace-with-a-long-random-token

# Dashboard：用于人工核对记忆条目，是验证材料里的第三方视角
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=true

# 数据目录：放在仓库之外，避免把数据库与日志提交进 Git
# Windows 示例：C:\Users\<you>\.recallcoach\data
POWERCONTEXT_HOME=C:\Users\replace-me\.recallcoach\data

# 监听地址与端口（默认即可；个人服务只支持 loopback）
# POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
# POWERCONTEXT_SERVER_HTTP_PORT=8000

# 默认使用 SQLite 后端，不需要 seekdb。
# 不配置 Generation / Embedding：显式记忆读写与全文检索不依赖模型，
# 这也是本项目"零 API Key 可复现"的前提。
